# AI Document Intelligence Platform Configuration

# OpenAI API Key for true LLM document parsing and conversational RAG
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# JWT Secret for Gateway & Auth Service (must be at least 32 characters)
JWT_SECRET=your-super-secret-key-which-is-at-least-32-characters-long
